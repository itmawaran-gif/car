<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>نظام إدارة السيارات</title>
    <link rel="manifest" href="manifest.json">
    <script src="https://unpkg.com/html5-qrcode"></script>
    <style>
        body { font-family: sans-serif; text-align: center; background: #f4f4f9; padding: 20px; }
        .card { background: white; padding: 20px; border-radius: 15px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
        button { background: #007bff; color: white; border: none; padding: 15px 30px; border-radius: 10px; font-size: 18px; cursor: pointer; margin: 10px; width: 100%; }
        input { padding: 12px; width: 90%; margin: 10px 0; border: 1px solid #ccc; border-radius: 5px; }
        #reader { width: 100%; border-radius: 10px; overflow: hidden; margin-top: 10px; }
        .status { color: #28a745; font-weight: bold; margin-top: 10px; }
    </style>
</head>
<body>

<div class="card" id="app">
    <h2 id="welcomeMsg">أهلاً بك</h2>
    
    <div id="nameSection" style="display:none;">
        <p>يرجى إدخال اسمك للمرة الأولى:</p>
        <input type="text" id="driverNameInput" placeholder="اسم السائق الثلاثي">
        <button onclick="saveName()">حفظ والبدء</button>
    </div>

    <div id="mainSection" style="display:none;">
        <p id="driverDisplayName"></p>
        <div id="reader" style="display:none;"></div>
        <button id="actionBtn" onclick="startScan()">بداية الرحلة</button>
        <p class="status" id="statusMsg"></p>
    </div>
</div>

<script>
    let driverName = localStorage.getItem('driverName');
    let isOnTrip = localStorage.getItem('isOnTrip') === 'true';
    const scriptURL = 'https://script.google.com/macros/s/AKfycbx89l4TEtUKO27rxIoeMqxa7Sv6phCPNzsZaCh-XEMxcaW2BKqGDF6Ig8o-spsvNP8m/exec'; // ضع رابط الـ Web App من Google Script

    window.onload = () => {
        if (!driverName) {
            document.getElementById('nameSection').style.display = 'block';
        } else {
            showMain();
        }
    };

    function saveName() {
        let name = document.getElementById('driverNameInput').value;
        if (name) {
            localStorage.setItem('driverName', name);
            driverName = name;
            showMain();
        }
    }

    function showMain() {
        document.getElementById('nameSection').style.display = 'none';
        document.getElementById('mainSection').style.display = 'block';
        document.getElementById('driverDisplayName').innerText = "السائق: " + driverName;
        updateUI();
    }

    function updateUI() {
        const btn = document.getElementById('actionBtn');
        if (isOnTrip) {
            btn.innerText = "تسليم السيارة (Scan QR)";
            btn.style.background = "#dc3545";
        } else {
            btn.innerText = "بداية الرحلة (Scan QR)";
            btn.style.background = "#007bff";
        }
    }

    function startScan() {
        document.getElementById('reader').style.display = 'block';
        const html5QrCode = new Html5Qrcode("reader");
        html5QrCode.start({ facingMode: "environment" }, { fps: 10, qrbox: 250 },
            (decodedText) => { // decodedText هو الـ ID الخاص بالسيارة من الكود
                sendData(decodedText);
                html5QrCode.stop();
                document.getElementById('reader').style.display = 'none';
            }
        ).catch(err => alert("خطأ في الكاميرا: " + err));
    }

    function sendData(carId) {
        const type = isOnTrip ? "end" : "start";
        const now = new Date().toLocaleString('ar-EG');
        
        document.getElementById('statusMsg').innerText = "جاري الإرسال...";

        fetch(scriptURL, {
            method: 'POST',
            mode: 'no-cors',
            body: JSON.stringify({
                driverName: driverName,
                carId: carId,
                time: now,
                type: type
            })
        }).then(() => {
            isOnTrip = !isOnTrip;
            localStorage.setItem('isOnTrip', isOnTrip);
            document.getElementById('statusMsg').innerText = "تم تسجيل البيانات بنجاح!";
            updateUI();
        }).catch(err => alert("حدث خطأ في الاتصال"));
    }
</script>
</body>
</html>
